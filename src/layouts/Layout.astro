---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/images/logoweb.svg"
      sizes="128x128"
    />
    <link
    rel="preload"
    as="image"
    href="/images/Perfil.webp"
  />
  <meta 
    name="description" 
    content="Frontend Developer portfolio of Jhonatan Vargas. Clean interfaces, solid code, and real results. Explore projects and contact information." 
  />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      const theme = localStorage.getItem("theme");

      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style></style>
